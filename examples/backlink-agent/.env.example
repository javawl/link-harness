# backlink-agent 环境模板：复制到 harness 仓库根目录命名为 .env（chmod 600）
# 模型网关（https://newapi.code0.vip）令牌 —— 全机器可共用
NEWAPI_API_KEY=sk-...
# supermanager Agent 令牌 —— 每台电脑在后台单独创建一枚（审计按令牌分开）
SUPERMANAGER_TOKEN=smag_...
# cloud-mail 开放接口令牌 —— 共用
CLOUDMAIL_TOKEN=...
# supermanager 地址：生产域名（VPS）或本地 dev 实例，二选一
SUPERMANAGER_BASE_URL=https://link.screwdom.org
# SUPERMANAGER_BASE_URL=http://127.0.0.1:3000
